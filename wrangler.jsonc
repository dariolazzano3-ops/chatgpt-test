{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chatgpt-test",
  "main": "src/entry.js",
  "compatibility_date": "2026-08-25",
  "access": {
    "dev": {
      "aud": "riosystems-operator-local",
      "identity": {
        "email": "operator@riosystems.local"
      }
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01
    },
    "traces": {
      "enabled": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatgpt-test-db",
      "database_id": "24bce336-3a04-4517-bd12-c9e713068d58"
    }
  ],
  "env": {
    "staging": {
      "name": "riosystems-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "RIOSYSTEMS_ENVIRONMENT": "staging",
        "RIOSYSTEMS_PRODUCTION_DEPLOY": "false",
        "RIOSYSTEMS_EXTERNAL_WRITES": "false",
        "FACTORY_CONTROL_BRANCH": "factory-control"
      },
      "d1_databases": [],
      "observability": {
        "enabled": false
      }
    }
  }
}
