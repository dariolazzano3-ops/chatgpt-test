{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chatgpt-test",
  "main": "src/entry.js",
  "compatibility_date": "2026-08-25",
  "keep_vars": true,
  "vars": {
    "AURENTARA_CUSTOMER_SURFACE_MODE": "off",
    "AURENTARA_CUSTOMER_DISTRIBUTED_RATE_ACTIVE": "true",
    "AURENTARA_CUSTOMER_OBSERVABILITY_ACTIVE": "true",
    "AURENTARA_CUSTOMER_OFFICIAL_RETRIEVAL_ACTIVE": "true",
    "AURENTARA_CUSTOMER_SUPABASE_URL": "https://pqmbtfzjcdnihovvppjr.supabase.co",
    "AURENTARA_CUSTOMER_SUPABASE_PROJECT_REF": "pqmbtfzjcdnihovvppjr",
    "AURENTARA_CUSTOMER_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_APgisjLicxi_l60r_CFcQQ_-UE-C_sh",
    "AURENTARA_OPERATOR_SUPABASE_PROJECT_REF": "pgzayxpqiakuvibhonwh"
  },
  "access": {
    "dev": {
      "aud": "riosystems-operator-local",
      "identity": {
        "email": "operator@riosystems.local"
      }
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01
    },
    "traces": {
      "enabled": false
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CUSTOMER_RATE_LIMITER",
        "class_name": "AurentaraCustomerRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "aurentara_customer_rate_limit_v1",
      "new_sqlite_classes": [
        "AurentaraCustomerRateLimiter"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatgpt-test-db",
      "database_id": "24bce336-3a04-4517-bd12-c9e713068d58"
    }
  ],
  "env": {
    "staging": {
      "name": "riosystems-staging",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "control.aurentarasystems.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "RIOSYSTEMS_ENVIRONMENT": "staging",
        "RIOSYSTEMS_PRODUCTION_DEPLOY": "false",
        "RIOSYSTEMS_EXTERNAL_WRITES": "false",
        "RIOSYSTEMS_OPERATOR_RUNTIME_STORE": "supabase",
        "RIOSYSTEMS_OPERATOR_RUNTIME_SUPABASE_URL": "https://pgzayxpqiakuvibhonwh.supabase.co",
        "RIOSYSTEMS_OPERATOR_RUNTIME_SUPABASE_TABLE": "riosystems_operator_runtime_v1",
        "FACTORY_CONTROL_BRANCH": "factory-control",
        "AURENTARA_CUSTOMER_SURFACE_MODE": "off",
        "AURENTARA_CUSTOMER_DISTRIBUTED_RATE_ACTIVE": "true",
        "AURENTARA_CUSTOMER_OBSERVABILITY_ACTIVE": "true",
        "AURENTARA_CUSTOMER_OFFICIAL_RETRIEVAL_ACTIVE": "true",
        "AURENTARA_CUSTOMER_SUPABASE_URL": "https://pqmbtfzjcdnihovvppjr.supabase.co",
        "AURENTARA_CUSTOMER_SUPABASE_PROJECT_REF": "pqmbtfzjcdnihovvppjr",
        "AURENTARA_CUSTOMER_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_APgisjLicxi_l60r_CFcQQ_-UE-C_sh",
        "AURENTARA_OPERATOR_SUPABASE_PROJECT_REF": "pgzayxpqiakuvibhonwh"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "CUSTOMER_RATE_LIMITER",
            "class_name": "AurentaraCustomerRateLimiter"
          }
        ]
      },
      "d1_databases": [],
      "observability": {
        "enabled": false
      }
    }
  }
}
