// FollowClean Worker config, used ONLY by .github/workflows/followclean-deploy.yml.
// Does not affect the repo-root wrangler.jsonc (Worker chatgpt-test).
// Bindings mirror the live worker: FC_APIFY_BUDGET_DB -> chatgpt-test-db (phase A).
// Phase B (separate release): switch database_id to followclean-db 28194058-2779-4b6d-ab81-b38459d5f6a8.
// Secrets (FC_APIFY_TOKEN, FC_IG_*, FC_STRIPE_*) stay in Cloudflare; vars kept via --keep-vars.
{
  "name": "followclean-mvp-preview",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-08-25",
  "d1_databases": [
    {
      "binding": "FC_APIFY_BUDGET_DB",
      "database_name": "chatgpt-test-db",
      "database_id": "24bce336-3a04-4517-bd12-c9e713068d58"
    }
  ]
}
