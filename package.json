{
  "name": "ziegenalarm-online",
  "private": true,
  "type": "module",
  "version": "0.7.1-dev",
  "scripts": {
    "dev": "node tools/build.mjs --face=neutral && node dev/server.js",
    "build": "node tools/build.mjs --face=neutral",
    "deploy": "node tools/build.mjs --face=neutral && wrangler deploy",
    "check:3d": "node tools/render-check.mjs",
